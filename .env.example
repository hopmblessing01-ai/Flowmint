# Contact form — Web3Forms (recommended): https://web3forms.com
# Enter blessing@flowmint.uk → get access key → add here + Netlify env → redeploy
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Optional backup: Resend (https://resend.com) — only if Web3Forms key is not set
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=blessing@flowmint.uk

# Admin panel on Netlify. Locally, create the password at /admin/login instead.
# ADMIN_PASSWORD=
# ADMIN_SESSION_SECRET=

# Optional: Google Search Console
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_verification_code
